# =============================================================================
# Vzorový .env — zkopíruj do souboru ".env" a doplň hodnoty
# =============================================================================

# Připojení k PostgreSQL (uživatel, heslo a databáze odpovídají docker-compose.yml)
# Formát: postgresql://UZIVATEL:HESLO@ADRESA:PORT/DATABAZE
DATABASE_URI=postgresql://skolka:skolka@127.0.0.1:5432/skolka

# Tajný klíč, kterým Payload podepisuje přihlašovací tokeny (JWT).
# Vygeneruj si dlouhý náhodný řetězec — NIKDY ho nesdílej ani necommituj.
PAYLOAD_SECRET=SEM_VLOZ_NAHODNY_RETEZEC

# Veřejná adresa webu — používá se pro SEO (sitemap, OG tagy), CORS a CSRF.
# Na produkci sem přijde skutečná doména, např. https://www.msujezerka.cz
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# S3 úložiště pro nahrané soubory (obrázky, dokumenty) — NEPOVINNÉ.
# Nech prázdné a soubory se budou ukládat normálně na disk (lokální vývoj).
# Na produkci (Zerops) sem Object Storage service doplní tyto hodnoty sama —
# viz zerops-project-import.yml.
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
